# Amplify Engage configs
CENTRAL_AUTH_CLIENTID=${ampcClientId}
CENTRAL_ORGANIZATIONID=${organizationId}
CENTRAL_ENVIRONMENT=${ampcEnvName}
CENTRAL_AGENTNAME=${ampcTAName}

# AWS configs
AWS_REGION=${region}
AWS_QUEUENAME=${traceabilityQueue}

# AWS Key configs
AWS_AUTH_ACCESSKEY=
AWS_AUTH_SECRETKEY=

# Logging configs
# Define the logging level: info, debug, error
LOG_LEVEL=info
# Specify where to send the log: stdout, file, both
LOG_OUTPUT=stdout
# Define where the log files are written
LOG_FILE_PATH=logs
